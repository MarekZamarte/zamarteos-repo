# Private PulseAudio core headers for out-of-tree modules (same PA ABI as the phone).
pkgname=pulsecore-headers-fp4
pkgver=17.0
pkgrel=2
pkgdesc="PulseAudio 17.0 private headers and pkg-config metadata for Droid modules"
arch=('any')
url="https://github.com/pulseaudio/pulseaudio"
license=('LGPL-2.1-or-later')
makedepends=('git' 'pulseaudio' 'pkgconf')
source=("pulseaudio::git+https://github.com/pulseaudio/pulseaudio.git#tag=v17.0")
sha256sums=('SKIP')

package() {
  cd "$srcdir/pulseaudio"
  install -d "$pkgdir/usr/include/pulsecore"
  find src/pulsecore -type f -name '*.h' -print0 | while IFS= read -r -d '' f; do
    rel="${f#src/pulsecore/}"
    install -D -m644 "$f" "$pkgdir/usr/include/pulsecore/$rel"
  done
  install -d "$pkgdir/usr/lib/pkgconfig"
  cat > "$pkgdir/usr/lib/pkgconfig/pulsecore.pc" <<'PC'
prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: pulsecore
Description: PulseAudio private core headers and linker flags (17.0 ABI)
Version: 17.0
Cflags: -I${includedir} -I${includedir}/pulsecore
Libs: -L${libdir}/pulseaudio -lpulsecore-17.0 -lpulsecommon-17.0
PC
  test -s "$pkgdir/usr/lib/pkgconfig/pulsecore.pc"
  test -s "$pkgdir/usr/include/pulsecore/module.h"
  test -s /usr/lib/pulseaudio/libpulsecore-17.0.so
  test -s /usr/lib/pulseaudio/libpulsecommon-17.0.so

  # PulseAudio private headers require the build's config.h to be included first.
  # The Droid Meson project generates config.h with PACKAGE and compiles with
  # HAVE_CONFIG_H, so reproduce that contract in this isolated smoke test.
  mkdir -p "$srcdir/pulsecore-smoke-config"
  cat > "$srcdir/pulsecore-smoke-config/config.h" <<'CONFIG'
#define PACKAGE "pulsecore-headers-fp4"
CONFIG
  cat > "$srcdir/pulsecore-link-check.c" <<'C'
#ifdef HAVE_CONFIG_H
#include <config.h>
#endif
#include <pulse/xmalloc.h>
#include <pulsecore/mem.h>

int main(void) {
  void *p = pa_xmalloc0(16);
  pa_xfree(p);
  return 0;
}
C

  # Compile against the staged private headers; link the actual installed
  # PulseAudio core and common libraries used by the FP4 Droid modules.
  local pulsecore_libs
  pulsecore_libs="$(PKG_CONFIG_PATH="$pkgdir/usr/lib/pkgconfig" pkg-config --libs pulsecore)"
  [[ "$pulsecore_libs" == *"-lpulsecore-17.0"* ]] || {
    echo "ERROR: pulsecore.pc does not link libpulsecore-17.0: $pulsecore_libs" >&2
    return 1
  }
  [[ "$pulsecore_libs" == *"-lpulsecommon-17.0"* ]] || {
    echo "ERROR: pulsecore.pc does not link libpulsecommon-17.0: $pulsecore_libs" >&2
    return 1
  }
  cc -DHAVE_CONFIG_H \
    -I"$srcdir/pulsecore-smoke-config" \
    -I"$pkgdir/usr/include" -I"$pkgdir/usr/include/pulsecore" \
    -o "$srcdir/pulsecore-link-check" "$srcdir/pulsecore-link-check.c" \
    $pulsecore_libs
}
