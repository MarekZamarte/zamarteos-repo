# Android 11 (API 30) public headers for the FP4 vendor HAL.
# Keep the legacy common headers needed by libhybris, but override the audio,
# hardware and libcutils interfaces with Google's pinned VNDK 30 ARM64 snapshot.
pkgname=hybris-android-headers
pkgver=11.0.0_30
pkgrel=1
pkgdesc="Android 11 VNDK 30 headers for libhybris and FP4 Droid audio"
arch=('aarch64')
url="https://android.googlesource.com/platform/prebuilts/vndk/v30"
license=('Apache-2.0')
makedepends=('libarchive' 'make' 'git')
options=('!strip')
source=('gls-common::git+https://github.com/mickybart/gnulinux_support-common#commit=d02ca07c443cebf183d8c8bc49b8bd06c49b41b')
sha256sums=('SKIP')

prepare() {
  mkdir -p "$srcdir/headers"
  bsdtar -xpf "$srcdir/gls-common/aur-blob/hybris-android-headers/android-headers-5.1.1_30.tgz" -C "$srcdir/headers"

  # Fetch only the required directories from Google's VNDK 30 snapshot.
  # Pin the upstream mirror commit and fail closed if its branch has moved.
  rm -rf "$srcdir/android-vndk-v30"
  git init "$srcdir/android-vndk-v30"
  git -C "$srcdir/android-vndk-v30" remote add origin \
    https://github.com/aosp-mirror-neo/platform_prebuilts_vndk_v30.git
  git -C "$srcdir/android-vndk-v30" sparse-checkout init --cone
  git -C "$srcdir/android-vndk-v30" sparse-checkout set \
    arm64/include/system/media/audio/include \
    arm64/include/hardware/libhardware/include \
    arm64/include/system/core/libcutils/include \
    arm64/include/system/core/libsystem/include
  git -C "$srcdir/android-vndk-v30" fetch --filter=blob:none --depth=1 origin 5f9884aa352825291757dfd6694b874ad8c1805e
  git -C "$srcdir/android-vndk-v30" checkout --detach FETCH_HEAD
  test "$(git -C "$srcdir/android-vndk-v30" rev-parse HEAD)" = \
    "5f9884aa352825291757dfd6694b874ad8c1805e"

  for required in \
    arm64/include/system/media/audio/include/system/audio.h \
    arm64/include/system/media/audio/include/system/audio-base.h \
    arm64/include/hardware/libhardware/include/hardware/audio.h \
    arm64/include/system/core/libcutils/include/cutils/bitops.h \
    arm64/include/system/core/libsystem/include/system/graphics.h; do
    test -s "$srcdir/android-vndk-v30/$required" || {
      echo "ERROR: pinned Android 11 VNDK header missing: $required" >&2
      return 1
    }
  done
}

package() {
  cd "$srcdir/headers"
  install -d "$pkgdir/opt/android"
  make DESTDIR="$pkgdir" PREFIX=/opt/android INCLUDEDIR=/opt/android/include PKGCONFIGDIR=/usr/lib/pkgconfig install

  # The bundled Android 5.1 header snapshot predates native_handle_clone(),
  # which is declared by Android 11 (VNDK 30) cutils/native_handle.h.
  # Add only the missing public prototype; implementation is provided by
  # the Android 11 libcutils runtime on the FP4.
  python3 - "$pkgdir/opt/android/include" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])
matches = list(root.rglob("native_handle.h"))
if len(matches) != 1:
    raise SystemExit(f"expected exactly one cutils/native_handle.h, found: {matches}")
header = matches[0]
if header.parent.name != "cutils":
    raise SystemExit(f"unexpected native_handle.h location: {header}")
text = header.read_text()
prototype = "native_handle_t* native_handle_clone(const native_handle_t* handle);"
if prototype not in text:
    if "native_handle_t" not in text:
        raise SystemExit("native_handle_t type missing; refusing incompatible header patch")
    pos = text.rfind("#endif")
    if pos < 0:
        raise SystemExit("header has no final #endif; refusing patch")
    text = text[:pos] + "/* Android 11 VNDK 30 API */\n" + prototype + "\n" + text[pos:]
    header.write_text(text)
PY
  grep -Fq 'native_handle_clone(const native_handle_t* handle)' "$pkgdir/opt/android/include/cutils/native_handle.h"
  # Keep VNDK 30 headers ahead of the legacy 5.1.1 compatibility snapshot.
  sed -i 's|Cflags:.*|Cflags: -I\${includedir}/vndk30/system/media/audio/include -I\${includedir}/vndk30/hardware/libhardware/include -I\${includedir}/vndk30/system/core/libcutils/include -I\${includedir}/vndk30/system/core/libsystem/include -I\${includedir}|' "$pkgdir/usr/lib/pkgconfig/android-headers.pc"

  local vndk="$srcdir/android-vndk-v30/arm64/include"
  local vndk_dest="$pkgdir/opt/android/include/vndk30"
  install -d "$vndk_dest/system/media/audio" "$vndk_dest/hardware/libhardware" \
    "$vndk_dest/system/core/libcutils" "$vndk_dest/system/core/libsystem"
  cp -a "$vndk/system/media/audio/include" "$vndk_dest/system/media/audio/"
  cp -a "$vndk/hardware/libhardware/include" "$vndk_dest/hardware/libhardware/"
  cp -a "$vndk/system/core/libcutils/include" "$vndk_dest/system/core/libcutils/"
  cp -a "$vndk/system/core/libsystem/include" "$vndk_dest/system/core/libsystem/"

  # Compile against the actual installed header search order. This catches
  # missing API 30 symbols and accidental fallback to the legacy headers.
  cat > "$srcdir/fp4-android11-audio-headers.cpp" <<'EOF'
#include <hardware/audio.h>
static_assert(AUDIO_DEVICE_IN_IP == 0x80080000u, "missing Android 11 input IP device");
static_assert(AUDIO_DEVICE_IN_BUS == 0x80100000u, "missing Android 11 input bus device");
static_assert(AUDIO_DEVICE_IN_PROXY == 0x81000000u, "missing Android 11 input proxy device");
static_assert(AUDIO_DEVICE_IN_USB_HEADSET == 0x82000000u, "missing Android 11 USB headset input");
static_assert(AUDIO_DEVICE_IN_BLUETOOTH_BLE == 0x84000000u, "missing Android 11 BLE input");
static_assert(AUDIO_DEVICE_IN_HDMI_ARC == 0x88000000u, "missing Android 11 HDMI ARC input");
static_assert(AUDIO_DEVICE_IN_ECHO_REFERENCE == 0x90000000u, "missing Android 11 echo reference input");
static_assert(AUDIO_DEVICE_OUT_IP == 0x00800000u, "missing Android 11 output IP device");
static_assert(AUDIO_DEVICE_OUT_BUS == 0x01000000u, "missing Android 11 output bus device");
static_assert(AUDIO_DEVICE_OUT_PROXY == 0x02000000u, "missing Android 11 output proxy device");
static_assert(AUDIO_DEVICE_OUT_USB_HEADSET == 0x04000000u, "missing Android 11 USB headset output");
static_assert(AUDIO_DEVICE_OUT_HEARING_AID == 0x08000000u, "missing Android 11 hearing aid output");
static_assert(AUDIO_DEVICE_OUT_ECHO_CANCELLER == 0x10000000u, "missing Android 11 echo canceller output");
static_assert(AUDIO_MODE_CALL_SCREEN == 4, "missing Android 11 call-screen mode");
static_assert(AUDIO_SOURCE_UNPROCESSED == 9, "missing Android 11 unprocessed source");
static_assert(AUDIO_SOURCE_VOICE_PERFORMANCE == 10, "missing Android 11 voice-performance source");
static_assert(AUDIO_OUTPUT_FLAG_TTS == 0x80, "missing Android 11 TTS output flag");
static_assert(AUDIO_OUTPUT_FLAG_RAW == 0x100, "missing Android 11 RAW output flag");
static_assert(AUDIO_OUTPUT_FLAG_SYNC == 0x200, "missing Android 11 SYNC output flag");
static_assert(AUDIO_OUTPUT_FLAG_IEC958_NONAUDIO == 0x400, "missing Android 11 IEC958 flag");
static_assert(AUDIO_OUTPUT_FLAG_DIRECT_PCM == 0x2000, "missing Android 11 direct PCM flag");
static_assert(AUDIO_OUTPUT_FLAG_MMAP_NOIRQ == 0x4000, "missing Android 11 MMAP output flag");
static_assert(AUDIO_OUTPUT_FLAG_VOIP_RX == 0x8000, "missing Android 11 VOIP RX flag");
static_assert(AUDIO_OUTPUT_FLAG_INCALL_MUSIC == 0x10000, "missing Android 11 incall music flag");
static_assert(AUDIO_INPUT_FLAG_RAW == 0x4, "missing Android 11 RAW input flag");
static_assert(AUDIO_INPUT_FLAG_SYNC == 0x8, "missing Android 11 SYNC input flag");
static_assert(AUDIO_INPUT_FLAG_MMAP_NOIRQ == 0x10, "missing Android 11 MMAP input flag");
static_assert(AUDIO_INPUT_FLAG_VOIP_TX == 0x20, "missing Android 11 VOIP TX flag");
static_assert(AUDIO_INPUT_FLAG_HW_AV_SYNC == 0x40, "missing Android 11 input AV sync flag");
static_assert(AUDIO_INPUT_FLAG_DIRECT == 0x80, "missing Android 11 direct input flag");
static_assert(AUDIO_FORMAT_FLAC == 0x1B000000u, "missing Android 11 FLAC format");
static_assert(AUDIO_FORMAT_SBC == 0x1F000000u, "missing Android 11 SBC format");
static_assert(sizeof(AUDIO_BOTTOM_MICROPHONE_ADDRESS) > 1, "missing Android 11 microphone address");
static_assert(sizeof(AUDIO_BACK_MICROPHONE_ADDRESS) > 1, "missing Android 11 back microphone address");
int main() { return 0; }
EOF
  g++ -std=c++11 -fsyntax-only \
    -I"$vndk_dest/system/media/audio/include" \
    -I"$vndk_dest/hardware/libhardware/include" \
    -I"$vndk_dest/system/core/libcutils/include" \
    -I"$vndk_dest/system/core/libsystem/include" \
    -I"$pkgdir/opt/android/include" \
    "$srcdir/fp4-android11-audio-headers.cpp"
  grep -Fq 'vndk30/system/media/audio/include' "$pkgdir/usr/lib/pkgconfig/android-headers.pc"
  grep -Fq 'vndk30/hardware/libhardware/include' "$pkgdir/usr/lib/pkgconfig/android-headers.pc"

  # Replace the obsolete Android 5.1 ANativeWindowBuffer member layout with
  # the public Android 11 VNDK/nativebase ABI definition. The FP4 vendor blobs
  # target API 30; libhybris 0.0.5.57 accesses layerCount and 64-bit usage.
  # This is an ABI layout replacement, not a synthetic field append.
  python3 - "$pkgdir/opt/android/include" <<'PY'
from pathlib import Path
import re
import sys

root = Path(sys.argv[1])
window = root / "system/window.h"
graphics = root / "system/graphics.h"
if not window.is_file() or not graphics.is_file():
    raise SystemExit(
        "expected the legacy compatibility headers at "
        f"{window} and {graphics}"
    )
source = window.read_text()
pattern = re.compile(
    r"(typedef struct ANativeWindowBuffer\s*\{.*?"
    r"struct android_native_base_t common;\s*)"
    r"(.*?)"
    r"(\}\s*ANativeWindowBuffer_t;)",
    re.S,
)
matches = list(pattern.finditer(source))
if len(matches) != 1:
    raise SystemExit(
        f"expected exactly one ANativeWindowBuffer definition in {window}; "
        f"found {len(matches)}"
    )

official_android11_members = """int width;
int height;
int stride;
int format;
int usage_deprecated;
uintptr_t layerCount;

void* reserved[1];

const native_handle_t* handle;
uint64_t usage;

/* Android 11 reserves the final slot for 64-bit usage compatibility. */
void* reserved_proc[8 - (sizeof(uint64_t) / sizeof(void*))];
"""
old_members = matches[0].group(2)
if "uintptr_t layerCount;" not in old_members:
    if "int usage;" not in old_members or "void* reserved[2];" not in old_members:
        raise SystemExit(
            "ANativeWindowBuffer is neither the expected legacy Android 5.1 "
            "layout nor an already patched Android 11 layout; refusing to guess"
        )
    source = source[:matches[0].start(2)] + official_android11_members + source[matches[0].end(2):]
    window.write_text(source)
else:
    # Do not silently accept a partial or hand-edited structure.
    normalized = re.sub(r"/\*.*?\*/", "", old_members, flags=re.S)
    normalized = re.sub(r"\s+", " ", normalized).strip()
    expected = re.sub(r"\\s+", " ", official_android11_members).strip()
    if normalized != expected:
        raise SystemExit(
            "ANativeWindowBuffer already contains layerCount but does not "
            "match the complete Android 11 member layout"
        )

gtext = graphics.read_text()
if "HAL_DATASPACE_UNKNOWN" not in gtext:
    gtext = gtext.rstrip() + """

/* Android 6+ dataspace default required by libhybris. */
#ifndef HAL_DATASPACE_UNKNOWN
#define HAL_DATASPACE_UNKNOWN 0
#endif
"""
    graphics.write_text(gtext)

updated = window.read_text()
required = (
    "int usage_deprecated;",
    "uintptr_t layerCount;",
    "const native_handle_t* handle;",
    "uint64_t usage;",
)
missing = [symbol for symbol in required if symbol not in updated]
if missing:
    raise SystemExit(f"{window}: Android 11 ANativeWindowBuffer ABI incomplete: {missing}")
if "HAL_DATASPACE_UNKNOWN" not in graphics.read_text():
    raise SystemExit(f"{graphics}: HAL_DATASPACE_UNKNOWN is missing")
PY

  # The bundled Android 5.1 system/window.h also lacks Android 8/9+
  # query/perform identifiers referenced by libhybris 0.0.5.57.
  # Values are the public Android native-window ABI values (API 30).
  python3 - "$pkgdir/opt/android/include" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])
matches = [p for p in root.rglob("window.h") if p.parent.name == "system"]
if len(matches) != 1:
    raise SystemExit(f"expected exactly one system/window.h, found: {matches}")
header = matches[0]
source = header.read_text()
compat = """
/* Android 8/9+ native-window identifiers missing from the legacy snapshot. */
#ifndef NATIVE_WINDOW_DEFAULT_DATASPACE
#define NATIVE_WINDOW_DEFAULT_DATASPACE 12
#endif
#ifndef NATIVE_WINDOW_BUFFER_AGE
#define NATIVE_WINDOW_BUFFER_AGE 13
#endif
#ifndef NATIVE_WINDOW_IS_VALID
#define NATIVE_WINDOW_IS_VALID 17
#endif
#ifndef NATIVE_WINDOW_MAX_BUFFER_COUNT
#define NATIVE_WINDOW_MAX_BUFFER_COUNT 21
#endif
#ifndef NATIVE_WINDOW_SET_USAGE64
#define NATIVE_WINDOW_SET_USAGE64 30
#endif
#ifndef NATIVE_WINDOW_GET_CONSUMER_USAGE64
#define NATIVE_WINDOW_GET_CONSUMER_USAGE64 31
#endif
"""
if "/* Android 8/9+ native-window identifiers missing from the legacy snapshot. */" not in source:
    pos = source.rfind("#endif")
    if pos < 0:
        raise SystemExit(f"{header}: no final include guard found")
    source = source[:pos] + compat + "\n" + source[pos:]
    header.write_text(source)

for name, value in {
    "NATIVE_WINDOW_DEFAULT_DATASPACE": 12,
    "NATIVE_WINDOW_BUFFER_AGE": 13,
    "NATIVE_WINDOW_IS_VALID": 17,
    "NATIVE_WINDOW_MAX_BUFFER_COUNT": 21,
    "NATIVE_WINDOW_SET_USAGE64": 30,
    "NATIVE_WINDOW_GET_CONSUMER_USAGE64": 31,
}.items():
    if f"#define {name} {value}" not in header.read_text():
        raise SystemExit(f"{header}: missing {name}={value}")
PY

  # Compile-time ABI gate: Android 11's ARM64 ANativeWindowBuffer layout is
  # 168 bytes, with layerCount/handle/usage at offsets 80/96/104.
  cat > "$srcdir/fp4-window-header-abi.cpp" <<'EOF'
#include <stddef.h>
#include <stdint.h>
#include <system/window.h>

static_assert(sizeof(((ANativeWindowBuffer*)0)->layerCount) == sizeof(uintptr_t),
              "Android 11 layerCount has the wrong type");
static_assert(sizeof(((ANativeWindowBuffer*)0)->usage) == sizeof(uint64_t),
              "Android 11 usage must be 64-bit");
static_assert(NATIVE_WINDOW_DEFAULT_DATASPACE == 12, "wrong Android native-window dataspace query");
static_assert(NATIVE_WINDOW_BUFFER_AGE == 13, "wrong Android native-window buffer-age query");
static_assert(NATIVE_WINDOW_IS_VALID == 17, "wrong Android native-window validity query");
static_assert(NATIVE_WINDOW_MAX_BUFFER_COUNT == 21, "wrong Android native-window max-buffer query");
static_assert(NATIVE_WINDOW_SET_USAGE64 == 30, "wrong Android native-window usage64 operation");
static_assert(NATIVE_WINDOW_GET_CONSUMER_USAGE64 == 31, "wrong Android native-window consumer-usage64 operation");
#if defined(__aarch64__)
static_assert(offsetof(ANativeWindowBuffer, layerCount) == 80,
              "ANativeWindowBuffer::layerCount offset does not match Android 11 ARM64 ABI");
static_assert(offsetof(ANativeWindowBuffer, handle) == 96,
              "ANativeWindowBuffer::handle offset does not match Android 11 ARM64 ABI");
static_assert(offsetof(ANativeWindowBuffer, usage) == 104,
              "ANativeWindowBuffer::usage offset does not match Android 11 ARM64 ABI");
static_assert(sizeof(ANativeWindowBuffer) == 168,
              "ANativeWindowBuffer size does not match Android 11 ARM64 ABI");
#endif
int main() { return 0; }
EOF
  g++ -std=c++11 \
    -I"$pkgdir/opt/android/include/vndk30/system/media/audio/include" \
    -I"$pkgdir/opt/android/include/vndk30/hardware/libhardware/include" \
    -I"$pkgdir/opt/android/include/vndk30/system/core/libcutils/include" \
    -I"$pkgdir/opt/android/include/vndk30/system/core/libsystem/include" \
    -I"$pkgdir/opt/android/include" \
    -c "$srcdir/fp4-window-header-abi.cpp" -o "$srcdir/fp4-window-header-abi.o"
  test -s "$srcdir/fp4-window-header-abi.o"


  # The FP4 vendor blobs target Android 11/API 30. libhybris checks these
  # macros to enable HAS_ANDROID_10_0_0 and WANT_LINKER_Q.
  local version_header="$pkgdir/opt/android/include/android-version.h"
  test -f "$version_header" || {
    echo "ERROR: android-version.h was not installed at the expected path" >&2
    find "$pkgdir/opt/android" -name android-version.h -print >&2
    return 1
  }
  sed -i \
    -e 's/^#define ANDROID_VERSION_MAJOR .*/#define ANDROID_VERSION_MAJOR 11/' \
    -e 's/^#define ANDROID_VERSION_MINOR .*/#define ANDROID_VERSION_MINOR 0/' \
    -e 's/^#define ANDROID_VERSION_PATCH .*/#define ANDROID_VERSION_PATCH 0/' \
    "$version_header"
  grep -q '^#define ANDROID_VERSION_MAJOR 11$' "$version_header"

  # Exact Android NDK android/rect.h declaration required by libhybris ui.c.
  install -d "$pkgdir/opt/android/include/android"
  cat > "$pkgdir/opt/android/include/android/rect.h" <<'EOF'
/*
 * Copyright (C) 2010 The Android Open Source Project
 * Licensed under the Apache License, Version 2.0.
 */
#ifndef ANDROID_RECT_H
#define ANDROID_RECT_H
#include <stdint.h>
#ifdef __cplusplus
extern "C" {
#endif
typedef struct ARect {
#ifdef __cplusplus
  typedef int32_t value_type;
#endif
  int32_t left;
  int32_t top;
  int32_t right;
  int32_t bottom;
} ARect;
#ifdef __cplusplus
};
#endif
#endif /* ANDROID_RECT_H */
EOF
  test -s "$pkgdir/opt/android/include/android/rect.h"
}
