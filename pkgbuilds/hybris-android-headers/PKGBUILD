# Android 11 (API 30) header metadata for the FP4 vendor HAL.
# The bundled header snapshot contains 5.1.1 declarations; libhybris uses
# ANDROID_VERSION_MAJOR to enable its Android 10+ linker implementation.
pkgname=hybris-android-headers
pkgver=5.1.1_30
pkgrel=5
pkgdesc="Android 11/API 30 headers for libhybris and FP4 Droid audio"
arch=('aarch64')
url="https://github.com/mickybart/gnulinux_support-common"
license=('custom')
makedepends=('libarchive' 'make')
options=('!strip')
source=('gls-common::git+https://github.com/mickybart/gnulinux_support-common#commit=d02ca07c443cebf183d8c8bc49b8bd06c49b41b')
sha256sums=('SKIP')

prepare() {
  mkdir -p "$srcdir/headers"
  bsdtar -xpf "$srcdir/gls-common/aur-blob/$pkgname/android-headers-$pkgver.tgz" -C "$srcdir/headers"
}

package() {
  cd "$srcdir/headers"
  install -d "$pkgdir/opt/android"
  make DESTDIR="$pkgdir" PREFIX=/opt/android INCLUDEDIR=/opt/android/include PKGCONFIGDIR=/usr/lib/pkgconfig install

  # The bundled Android 5.1 header snapshot predates native_handle_clone(),
  # which is declared by Android 11 (VNDK 30) cutils/native_handle.h.
  # Add only the missing public prototype; implementation is provided by
  # the Android 11 libcutils runtime on the FP4.
  python3 - "$pkgdir/opt/android/include" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])
matches = list(root.rglob("native_handle.h"))
if len(matches) != 1:
    raise SystemExit(f"expected exactly one cutils/native_handle.h, found: {matches}")
header = matches[0]
if header.parent.name != "cutils":
    raise SystemExit(f"unexpected native_handle.h location: {header}")
text = header.read_text()
prototype = "native_handle_t* native_handle_clone(const native_handle_t* handle);"
if prototype not in text:
    if "native_handle_t" not in text:
        raise SystemExit("native_handle_t type missing; refusing incompatible header patch")
    pos = text.rfind("#endif")
    if pos < 0:
        raise SystemExit("header has no final #endif; refusing patch")
    text = text[:pos] + "/* Android 11 VNDK 30 API */\n" + prototype + "\n" + text[pos:]
    header.write_text(text)
PY
  grep -Fq 'native_handle_clone(const native_handle_t* handle)' "$pkgdir/opt/android/include/cutils/native_handle.h"
  sed -i 's|Cflags:.*|Cflags: -I\${includedir}|' "$pkgdir/usr/lib/pkgconfig/android-headers.pc"

  # The pinned 5.1.1 snapshot is missing public Android 6/8/9 native-window
  # declarations used by the Android-11-targeted libhybris source. Supply the
  # stable API constants required by that source without changing ABI structs.
  python3 - "$pkgdir/opt/android/include" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])
window_headers = list(root.rglob("window.h"))
graphics_headers = list(root.rglob("graphics.h"))
window_headers = [p for p in window_headers if p.parent.name == "system"]
graphics_headers = [p for p in graphics_headers if p.parent.name == "system"]
if len(window_headers) != 1 or len(graphics_headers) != 1:
    raise SystemExit(
        "expected exactly one system/window.h and system/graphics.h; "
        f"found {window_headers} and {graphics_headers}"
    )

window = window_headers[0]
text = window.read_text()
compat = """
/* Android 6/8/9 native-window API constants missing from the pinned 5.1.1 snapshot. */
#ifndef NATIVE_WINDOW_DEFAULT_DATASPACE
#define NATIVE_WINDOW_DEFAULT_DATASPACE 12
#endif
#ifndef NATIVE_WINDOW_BUFFER_AGE
#define NATIVE_WINDOW_BUFFER_AGE 13
#endif
#ifndef NATIVE_WINDOW_IS_VALID
#define NATIVE_WINDOW_IS_VALID 17
#endif
#ifndef NATIVE_WINDOW_MAX_BUFFER_COUNT
#define NATIVE_WINDOW_MAX_BUFFER_COUNT 21
#endif
#ifndef NATIVE_WINDOW_SET_USAGE64
#define NATIVE_WINDOW_SET_USAGE64 30
#endif
#ifndef NATIVE_WINDOW_GET_CONSUMER_USAGE64
#define NATIVE_WINDOW_GET_CONSUMER_USAGE64 31
#endif
"""
if "ZamarteOS Android native-window compatibility constants" not in text:
    compat = compat.replace(
        "/* Android 6/8/9 native-window API constants missing from the pinned 5.1.1 snapshot. */",
        "/* ZamarteOS Android native-window compatibility constants. */"
    )
    window.write_text(text.rstrip() + "\n\n" + compat)

graphics = graphics_headers[0]
gtext = graphics.read_text()
if "HAL_DATASPACE_UNKNOWN" not in gtext:
    gtext = gtext.rstrip() + """

/* Android 6+ dataspace default required by libhybris. */
#ifndef HAL_DATASPACE_UNKNOWN
#define HAL_DATASPACE_UNKNOWN 0
#endif
"""
    graphics.write_text(gtext)

for name, path in (("window", window), ("graphics", graphics)):
    data = path.read_text()
    if name == "window":
        required = (
            "NATIVE_WINDOW_DEFAULT_DATASPACE",
            "NATIVE_WINDOW_BUFFER_AGE",
            "NATIVE_WINDOW_IS_VALID",
            "NATIVE_WINDOW_MAX_BUFFER_COUNT",
            "NATIVE_WINDOW_SET_USAGE64",
            "NATIVE_WINDOW_GET_CONSUMER_USAGE64",
        )
    else:
        required = ("HAL_DATASPACE_UNKNOWN",)
    missing = [symbol for symbol in required if symbol not in data]
    if missing:
        raise SystemExit(f"{path}: missing compatibility symbols: {missing}")
PY

  # The FP4 vendor blobs target Android 11/API 30. libhybris checks these
  # macros to enable HAS_ANDROID_10_0_0 and WANT_LINKER_Q.
  local version_header="$pkgdir/opt/android/include/android-version.h"
  test -f "$version_header" || {
    echo "ERROR: android-version.h was not installed at the expected path" >&2
    find "$pkgdir/opt/android" -name android-version.h -print >&2
    return 1
  }
  sed -i \
    -e 's/^#define ANDROID_VERSION_MAJOR .*/#define ANDROID_VERSION_MAJOR 11/' \
    -e 's/^#define ANDROID_VERSION_MINOR .*/#define ANDROID_VERSION_MINOR 0/' \
    -e 's/^#define ANDROID_VERSION_PATCH .*/#define ANDROID_VERSION_PATCH 0/' \
    "$version_header"
  grep -q '^#define ANDROID_VERSION_MAJOR 11$' "$version_header"

  # Exact Android NDK android/rect.h declaration required by libhybris ui.c.
  install -d "$pkgdir/opt/android/include/android"
  cat > "$pkgdir/opt/android/include/android/rect.h" <<'EOF'
/*
 * Copyright (C) 2010 The Android Open Source Project
 * Licensed under the Apache License, Version 2.0.
 */
#ifndef ANDROID_RECT_H
#define ANDROID_RECT_H
#include <stdint.h>
#ifdef __cplusplus
extern "C" {
#endif
typedef struct ARect {
#ifdef __cplusplus
  typedef int32_t value_type;
#endif
  int32_t left;
  int32_t top;
  int32_t right;
  int32_t bottom;
} ARect;
#ifdef __cplusplus
};
#endif
#endif /* ANDROID_RECT_H */
EOF
  test -s "$pkgdir/opt/android/include/android/rect.h"
}
