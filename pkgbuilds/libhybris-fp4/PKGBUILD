# ARM64 libhybris build for the Fairphone 4 Sailfish audio HAL.
pkgname=libhybris-fp4
pkgver=0.0.5.57
pkgrel=5
pkgdesc="libhybris Android hardware compatibility layer for ZamarteOS FP4"
arch=('aarch64')
url="https://github.com/libhybris/libhybris"
license=('Apache-2.0')
depends=('glibc' 'hybris-android-headers' 'wayland')
makedepends=('autoconf' 'automake' 'libtool' 'make' 'gcc' 'pkgconf' 'wayland' 'hybris-android-headers')
source=("libhybris::git+https://github.com/libhybris/libhybris#commit=7079712a42ea2754adf747e70c6cc75764c8596e")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/libhybris"
  # ui_compatibility_layer.h declares Android 10+ gralloc APIs using
  # buffer_handle_t and ARect, but the public header does not include the
  # Android HAL headers that define those types. Make it self-contained.
  python3 - <<'PY'
from pathlib import Path
p = Path("hybris/include/hybris/ui/ui_compatibility_layer.h")
s = p.read_text()
needle = "#include <unistd.h>\n"
addition = """#include <unistd.h>

#if ANDROID_VERSION_MAJOR >= 10
#include <hardware/gralloc.h>
#include <android/rect.h>
#endif
"""
if addition not in s:
    if needle not in s:
        raise SystemExit("ui_compatibility_layer.h include anchor changed")
    s = s.replace(needle, addition, 1)
p.write_text(s)
PY
  grep -Fq '#include <hardware/gralloc.h>' hybris/include/hybris/ui/ui_compatibility_layer.h
  grep -Fq '#include <android/rect.h>' hybris/include/hybris/ui/ui_compatibility_layer.h
}

build() {
  cd "$srcdir/libhybris/hybris"
  export CPPFLAGS="-D_DEFAULT_SOURCE -I/opt/android/include ${CPPFLAGS:-}"
  echo "==> libhybris compiler environment"
  gcc --version
  printf 'CC=%s\nCFLAGS=%s\nCPPFLAGS=%s\nLDFLAGS=%s\n' "${CC:-gcc}" "${CFLAGS:-}" "${CPPFLAGS:-}" "${LDFLAGS:-}"
  printf 'int main(void) { return 0; }\n' > /tmp/zamarteos-cc-test.c
  gcc ${CFLAGS:-} ${CPPFLAGS:-} /tmp/zamarteos-cc-test.c ${LDFLAGS:-} -o /tmp/zamarteos-cc-test || {
    echo "ERROR: standalone ARM64 compiler/linker preflight failed" >&2
    return 1
  }
  if ! ./autogen.sh --enable-arch=arm64 --prefix=/opt/android/hybris --with-android-headers=/opt/android/include --enable-wayland; then
    echo "ERROR: libhybris configure failed; preserving config.log" >&2
    if [ -f config.log ]; then
      cp config.log /out/libhybris-config.log
      tail -n 160 config.log
    else
      echo "config.log was not created" >&2
    fi
    return 1
  fi
  make
}
package() {
  cd "$srcdir/libhybris/hybris"
  make -j1 DESTDIR="$pkgdir" install
  install -d "$pkgdir/usr/lib"
  if [ -d "$pkgdir/opt/android/hybris/lib/pkgconfig" ]; then
    mv "$pkgdir/opt/android/hybris/lib/pkgconfig" "$pkgdir/usr/lib/pkgconfig"
  fi
  # EGL and GLESv2 pkg-config metadata is provided by libglvnd on Arch.
  # libhybris installs copies with the same names; do not ship duplicate
  # ownership or replace the system's GLVND metadata.
  rm -f "$pkgdir/usr/lib/pkgconfig/egl.pc" "$pkgdir/usr/lib/pkgconfig/glesv2.pc"
  # Expose the HAL compatibility libraries through the normal runtime linker path.
  # Keep both the real versioned shared objects and libtool's SONAME/
  # linker-name symlinks. Meson uses cc.find_library('hybris-common'), which
  # specifically needs libhybris-common.so (not only .so.1.0.0).
  find "$pkgdir/opt/android/hybris/lib" -maxdepth 1 \\( -type f -o -type l \\) -name '*.so*' -printf '%f\\n' 2>/dev/null | while read -r f; do
    [ -e "$pkgdir/opt/android/hybris/lib/$f" ] || continue
    [ -e "$pkgdir/usr/lib/$f" ] || [ -L "$pkgdir/usr/lib/$f" ] || ln -s "/opt/android/hybris/lib/$f" "$pkgdir/usr/lib/$f"
  done
  test -L "$pkgdir/usr/lib/libhybris-common.so" || {
    echo "ERROR: libhybris-common.so linker symlink is missing from /usr/lib" >&2
    find "$pkgdir/opt/android/hybris/lib" -maxdepth 1 -name 'libhybris-common.so*' -ls >&2
    return 1
  }
  test -L "$pkgdir/usr/lib/libhardware.so" || {
    echo "ERROR: libhardware.so linker symlink is missing from /usr/lib" >&2
    find "$pkgdir/opt/android/hybris/lib" -maxdepth 1 -name 'libhardware.so*' -ls >&2
    return 1
  }
  # The Droid audio module's Meson build resolves libhardware via pkg-config.
  test -s "$pkgdir/usr/lib/pkgconfig/libhardware.pc" || {
    echo "ERROR: libhybris did not install libhardware.pc" >&2
    find "$pkgdir" -iname '*hardware*.pc' -print >&2
    return 1
  }
}
