pkgname=zamarteos-shell
pkgver=0.1.6
pkgrel=1
pkgdesc="ZamarteOS first-boot security integration for Fairphone 4"
arch=('aarch64')
url="https://github.com/MarekZamarte/zamarteos-repo"
license=('unknown')
depends=('pam')
source=(
  'zamarteos-firstboot-pin'
  'zamarteos-firstboot-pin.service'
  'moarchy-firstboot-pin.conf'
  'getty-firstboot-pin.conf'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

check() {
  bash -n "$srcdir/zamarteos-firstboot-pin"
  grep -q 'od -An -N4 -tu4 /dev/urandom' "$srcdir/zamarteos-firstboot-pin"
  grep -q 'PIERWSZE-URUCHOMIENIE.txt' "$srcdir/zamarteos-firstboot-pin"
  grep -q 'chpasswd -c SHA512' "$srcdir/zamarteos-firstboot-pin"
  grep -q 'Before=moarchy-firstboot.service getty@tty1.service' "$srcdir/zamarteos-firstboot-pin.service"
  grep -q 'Requires=zamarteos-firstboot-pin.service' "$srcdir/moarchy-firstboot-pin.conf"
  grep -q 'Requires=moarchy-firstboot.service' "$srcdir/getty-firstboot-pin.conf"
}

package() {
  install -Dm755 "$srcdir/zamarteos-firstboot-pin" "$pkgdir/usr/lib/zamarteos/firstboot-pin"
  install -Dm644 "$srcdir/zamarteos-firstboot-pin.service" "$pkgdir/usr/lib/systemd/system/zamarteos-firstboot-pin.service"
  install -Dm644 "$srcdir/moarchy-firstboot-pin.conf" "$pkgdir/usr/lib/systemd/system/moarchy-firstboot.service.d/10-zamarteos-pin.conf"
  install -Dm644 "$srcdir/getty-firstboot-pin.conf" "$pkgdir/usr/lib/systemd/system/getty@tty1.service.d/10-zamarteos-firstboot.conf"
}
