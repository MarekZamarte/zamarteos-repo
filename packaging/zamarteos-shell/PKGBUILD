pkgname=zamarteos-shell
pkgver=0.1.2
pkgrel=1
pkgdesc="ZamarteOS Pure mobile home shell for Fairphone 4"
arch=('aarch64')
url="https://github.com/MarekZamarte/zamarteos-repo"
license=('unknown')
depends=('quickshell' 'hyprland' 'pam')
makedepends=('qt6-declarative')
source=('shell.qml' 'zamarteos-lock.pam')
sha256sums=('SKIP' 'SKIP')

check() {
  grep -q 'WlSessionLock' "$srcdir/shell.qml"
  grep -q 'PamContext' "$srcdir/shell.qml"
  grep -q 'zamarteos-lock' "$srcdir/shell.qml"
  grep -q 'DesktopEntries.applications' "$srcdir/shell.qml"
  grep -q 'function isVisibleApp(entry)' "$srcdir/shell.qml"
  grep -q 'id.indexOf("moarchy")' "$srcdir/shell.qml"
  grep -q 'name.indexOf("omarchy")' "$srcdir/shell.qml"
  test -x /usr/lib/qt6/bin/qmllint
  /usr/lib/qt6/bin/qmllint -I /usr/lib/qt6/qml "$srcdir/shell.qml"
}

package() {
  install -Dm644 "$srcdir/shell.qml" "$pkgdir/usr/share/zamarteos-shell/shell.qml"
  install -Dm644 "$srcdir/zamarteos-lock.pam" "$pkgdir/etc/pam.d/zamarteos-lock"
}
