pkgname=zamarteos-shell
pkgver=0.2.0
pkgrel=1
pkgdesc="ZamarteOS touch-first Wayland shell and Fairphone 4 session"
arch=('aarch64')
url="https://github.com/MarekZamarte/zamarteos-repo"
license=('custom')
depends=('hyprland' 'quickshell' 'pam')
source=(
  'shell.qml'
  'hyprland.conf'
  'zamarteos-session'
  'zamarteos-shell'
  'zamarteos.desktop'
  'zamarteos-lock.pam'
  'zamarteos-firstboot-pin'
  'zamarteos-firstboot-pin.service'
  'moarchy-firstboot-pin.conf'
  'getty-firstboot-pin.conf'
  'polish-letters.json'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

check() {
  bash -n "$srcdir/zamarteos-session"
  bash -n "$srcdir/zamarteos-shell"
  bash -n "$srcdir/zamarteos-firstboot-pin"
  grep -q 'exec Hyprland --config /usr/share/zamarteos-shell/hyprland.conf' "$srcdir/zamarteos-session"
  grep -q 'exec qs -n -p /usr/share/zamarteos-shell' "$srcdir/zamarteos-shell"
  grep -q 'IpcHandler' "$srcdir/shell.qml"
  grep -q 'target: "zamarteos-lock"' "$srcdir/shell.qml"
  grep -q 'od -An -N4 -tu4 /dev/urandom' "$srcdir/zamarteos-firstboot-pin"
  grep -q 'PIERWSZE-URUCHOMIENIE.txt' "$srcdir/zamarteos-firstboot-pin"
  grep -q 'chpasswd -c SHA512' "$srcdir/zamarteos-firstboot-pin"
  grep -q 'Before=moarchy-firstboot.service getty@tty1.service' "$srcdir/zamarteos-firstboot-pin.service"
  grep -q 'Requires=zamarteos-firstboot-pin.service' "$srcdir/moarchy-firstboot-pin.conf"
  grep -q 'Requires=moarchy-firstboot.service' "$srcdir/getty-firstboot-pin.conf"
  python3 -m json.tool "$srcdir/polish-letters.json" >/dev/null
  for char in ą ć ę ł ń ó ś ź ż Ą Ć Ę Ł Ń Ó Ś Ź Ż; do
    grep -Fq "$char" "$srcdir/polish-letters.json"
  done
}

package() {
  install -Dm644 "$srcdir/shell.qml" "$pkgdir/usr/share/zamarteos-shell/shell.qml"
  install -Dm644 "$srcdir/hyprland.conf" "$pkgdir/usr/share/zamarteos-shell/hyprland.conf"
  install -Dm755 "$srcdir/zamarteos-session" "$pkgdir/usr/bin/zamarteos-session"
  install -Dm755 "$srcdir/zamarteos-shell" "$pkgdir/usr/bin/zamarteos-shell"
  install -Dm644 "$srcdir/zamarteos.desktop" "$pkgdir/usr/share/wayland-sessions/zamarteos.desktop"
  install -Dm644 "$srcdir/zamarteos-lock.pam" "$pkgdir/etc/pam.d/zamarteos-lock"
  install -Dm755 "$srcdir/zamarteos-firstboot-pin" "$pkgdir/usr/lib/zamarteos/firstboot-pin"
  install -Dm644 "$srcdir/zamarteos-firstboot-pin.service" "$pkgdir/usr/lib/systemd/system/zamarteos-firstboot-pin.service"
  install -Dm644 "$srcdir/moarchy-firstboot-pin.conf" "$pkgdir/usr/lib/systemd/system/moarchy-firstboot.service.d/10-zamarteos-pin.conf"
  install -Dm644 "$srcdir/getty-firstboot-pin.conf" "$pkgdir/usr/lib/systemd/system/getty@tty1.service.d/10-zamarteos-firstboot.conf"
  # useradd copies /etc/skel into the new phone account during image creation.
  install -Dm644 "$srcdir/polish-letters.json" "$pkgdir/etc/skel/.config/moarchy-keyboard/layouts/letters.json"
}
