[Unit]
Description=ZamarteOS first-boot PIN setup
After=systemd-user-sessions.service
Before=moarchy-firstboot.service getty@tty1.service
ConditionPathExists=!/var/lib/zamarteos/firstboot-pin-done

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=0
ExecStart=/usr/lib/zamarteos/firstboot-pin
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=no
TTYVTDisallocate=no
